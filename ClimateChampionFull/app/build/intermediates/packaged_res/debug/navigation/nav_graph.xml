<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.climatechampion.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_topicDetailFragment"
            app:destination="@id/topicDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_carbonCalculatorFragment"
            app:destination="@id/carbonCalculatorFragment" />
    </fragment>

    <!-- Topics -->
    <fragment
        android:id="@+id/topicListFragment"
        android:name="com.climatechampion.ui.topics.TopicListFragment"
        android:label="Topics"
        tools:layout="@layout/fragment_topic_list">
        <action
            android:id="@+id/action_topicListFragment_to_topicDetailFragment"
            app:destination="@id/topicDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/topicDetailFragment"
        android:name="com.climatechampion.ui.topics.TopicDetailFragment"
        android:label="Topic Detail"
        tools:layout="@layout/fragment_topic_detail">
        <argument
            android:name="topicId"
            app:argType="string" />
        <action
            android:id="@+id/action_topicDetailFragment_to_quizFragment"
            app:destination="@id/quizFragment" />
        <action
            android:id="@+id/action_topicDetailFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <!-- Videos -->
    <fragment
        android:id="@+id/videoListFragment"
        android:name="com.climatechampion.ui.video.VideoListFragment"
        android:label="Videos"
        tools:layout="@layout/fragment_video_list">
        <action
            android:id="@+id/action_videoListFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.climatechampion.ui.video.VideoPlayerFragment"
        android:label="Watch"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="videoId"
            app:argType="string" />
        <action
            android:id="@+id/action_videoPlayerFragment_self"
            app:destination="@id/videoPlayerFragment"
            app:popUpTo="@id/videoPlayerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Quiz -->
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.climatechampion.ui.quiz.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz">
        <argument
            android:name="topicId"
            app:argType="string" />
        <action
            android:id="@+id/action_quizFragment_to_quizResultFragment"
            app:destination="@id/quizResultFragment"
            app:popUpTo="@id/quizFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/quizResultFragment"
        android:name="com.climatechampion.ui.quiz.QuizResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_quiz_result">
        <argument android:name="score" app:argType="integer" />
        <argument android:name="totalQuestions" app:argType="integer" />
        <argument android:name="percentage" app:argType="float" />
        <argument android:name="passed" app:argType="boolean" />
        <argument android:name="pointsEarned" app:argType="integer" />
        <argument android:name="topicId" app:argType="string" />
        <action
            android:id="@+id/action_quizResultFragment_to_quizFragment"
            app:destination="@id/quizFragment"
            app:popUpTo="@id/quizResultFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Leaderboard -->
    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.climatechampion.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <!-- Profile -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.climatechampion.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ── Carbon Calculator ────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/carbonCalculatorFragment"
        android:name="com.climatechampion.ui.calculator.CarbonCalculatorFragment"
        android:label="Carbon Calculator"
        tools:layout="@layout/fragment_carbon_calculator">
        <action
            android:id="@+id/action_carbonCalculatorFragment_to_carbonResultFragment"
            app:destination="@id/carbonResultFragment"
            app:popUpTo="@id/carbonCalculatorFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/carbonResultFragment"
        android:name="com.climatechampion.ui.calculator.CarbonResultFragment"
        android:label="My Footprint"
        tools:layout="@layout/fragment_carbon_result" />

</navigation>
